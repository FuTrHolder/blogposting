# 완전 무료 버전 환경변수
# 이 파일을 .env로 복사 후 실제 값 입력
# .env는 절대 GitHub에 커밋하지 마세요!

# Google Gemini API (무료)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx

# Alpha Vantage (무료)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Hugging Face (무료)
HF_API_TOKEN=hf_xxxxxxxxxx

# 티스토리 카카오 로그인 정보 (Access Token 대신 사용)
KAKAO_EMAIL=your_kakao_email@kakao.com
KAKAO_PASSWORD=your_kakao_password
TISTORY_BLOG_NAME=yourblogname
